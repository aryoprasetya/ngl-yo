async function verifyIdentity() {

  const name =
    document.getElementById("verifyName")
      .value
      .trim();

  const video =
    document.getElementById("faceVideo");

  if (!name) {

    setVerificationStatus(
      "Nama wajib diisi.",
      "error"
    );

    return;

  }

  if (!video.srcObject) {

    setVerificationStatus(
      "Aktifkan kamera terlebih dahulu.",
      "error"
    );

    return;

  }

  setVerificationStatus(
    "Menganalisis wajah...",
    ""
  );

  try {

    const detection =
      await faceapi
        .detectSingleFace(
          video,
          new faceapi.TinyFaceDetectorOptions()
        )
        .withFaceLandmarks()
        .withFaceDescriptor();

    if (!detection) {

      setVerificationStatus(
        "Wajah belum terdeteksi. Pastikan wajah terlihat jelas.",
        "error"
      );

      return;

    }

    faceDescriptor =
      Array.from(
        detection.descriptor
      );

    setVerificationStatus(
      "Mencari identitas...",
      ""
    );

    const response =
      await fetch(
        AUTH_CONFIG.API_URL,
        {
          method: "POST",

          headers: {
            "Content-Type": "text/plain;charset=utf-8"
          },

          body: JSON.stringify({
            action: "verify",
            name: name,
            faceDescriptor: faceDescriptor
          })
        }
      );

    const result =
      await response.json();

    if (!result.success) {

      setVerificationStatus(
        result.message ||
        "Verifikasi gagal.",
        "error"
      );

      return;

    }

    /**
     * Cocokkan wajah dengan
     * descriptor yang tersimpan.
     */
    const storedDescriptor =
      new Float32Array(
        result.storedDescriptor
      );

    const distance =
      faceapi.euclideanDistance(
        detection.descriptor,
        storedDescriptor
      );

    /**
     * Semakin kecil semakin mirip.
     *
     * Threshold 0.50 dibuat cukup ketat.
     */
    if (distance > 0.50) {

      setVerificationStatus(
        "Wajah tidak cocok dengan akun tersebut.",
        "error"
      );

      return;

    }

    verifiedUser =
      result.user;

    localStorage.setItem(
      "ngl-session",
      JSON.stringify({
        id: verifiedUser.id,
        name: verifiedUser.name,
        role: verifiedUser.role,
        verifiedAt: Date.now()
      })
    );

    enterNGL();

  } catch (error) {

    console.error(error);

    setVerificationStatus(
      "Terjadi kesalahan saat melakukan verifikasi.",
      "error"
    );

  }

}

