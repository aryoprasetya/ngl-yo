async function startFaceVerification() {
  try {
    const status = document.getElementById('faceStatus');

    if (status) {
      status.textContent = 'Menyiapkan verifikasi wajah...';
    }

    // Pastikan model face-api sudah siap
    if (typeof faceapi === 'undefined') {
      throw new Error('Library face-api belum dimuat.');
    }

    // Jika fungsi loader tersedia, jalankan terlebih dahulu
    if (typeof loadFaceModels === 'function') {
      await loadFaceModels();
    }

    // Jalankan kamera
    if (typeof startCamera === 'function') {
      await startCamera();
    } else {
      throw new Error('Fungsi startCamera() belum tersedia.');
    }

    if (status) {
      status.textContent = 'Kamera aktif. Posisikan wajah di dalam area.';
    }

  } catch (error) {
    console.error('Face verification error:', error);

    const status = document.getElementById('faceStatus');

    if (status) {
      status.textContent = error.message || 'Verifikasi wajah gagal.';
    }

    if (typeof showToast === 'function') {
      showToast(
        error.message || 'Tidak dapat memulai verifikasi wajah.',
        'error'
      );
    }
  }
}

