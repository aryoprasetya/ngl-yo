<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f5f7fb">
  <meta name="description" content="Network Gateway Link — pusat akses aplikasi, layanan, kesehatan jiwa, dan donasi.">
<script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
  <title>Network Gateway Link</title>

  <!-- Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Boxicons -->
  <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">

  <style>
    :root {
      --bg: #f5f7fb;
      --surface: #ffffff;
      --surface-2: #f8f9fc;
      --text: #172033;
      --muted: #7b8496;
      --border: #e9edf3;

      --primary: #4f46e5;
      --primary-dark: #3730a3;
      --primary-soft: #eef0ff;

      --green: #15966b;
      --green-soft: #eaf9f3;

      --orange: #e88a18;
      --orange-soft: #fff5e7;

      --pink: #db4b82;
      --pink-soft: #fff0f5;

      --blue: #3982e6;
      --blue-soft: #edf5ff;

      --shadow: 0 10px 35px rgba(23, 32, 51, .07);
      --shadow-small: 0 5px 18px rgba(23, 32, 51, .06);

      --radius-xl: 26px;
      --radius-lg: 20px;
      --radius-md: 15px;

      --nav-height: 76px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Manrope", sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
      transition: background .25s ease, color .25s ease;
    }

    button,
    input {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* =========================
       APP SHELL
    ========================= */

    .app {
      width: 100%;
      max-width: 1180px;
      margin: auto;
      min-height: 100vh;
      padding: 0 22px 110px;
    }

    /* =========================
       HEADER
    ========================= */

    .topbar {
      height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      z-index: 20;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
    }

    .brand-logo {
      width: 43px;
      height: 43px;
      border-radius: 14px;
      background: linear-gradient(145deg, #5b5cf0, #4038c9);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 7px 18px rgba(79, 70, 229, .23);
    }

    .brand-logo i {
      font-size: 23px;
    }

    .brand-name {
      line-height: 1.05;
    }

    .brand-name strong {
      display: block;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: -.4px;
    }

    .brand-name span {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: .3px;
    }

    .header-actions {
      display: flex;
      gap: 8px;
    }

    .icon-button {
      width: 42px;
      height: 42px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      border-radius: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: .2s ease;
    }

    .icon-button:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-small);
    }

    .icon-button i {
      font-size: 20px;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      position: relative;
      overflow: hidden;
      min-height: 260px;
      border-radius: var(--radius-xl);
      background:
        radial-gradient(circle at 90% 10%, rgba(255,255,255,.23) 0 8%, transparent 30%),
        radial-gradient(circle at 70% 100%, rgba(255,255,255,.1) 0 10%, transparent 32%),
        linear-gradient(125deg, #4038c9 0%, #5758e8 52%, #7b69ed 100%);
      color: white;
      padding: 35px 38px;
      display: flex;
      align-items: center;
      box-shadow: 0 16px 40px rgba(79, 70, 229, .2);
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 210px;
      height: 210px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 50%;
      right: -65px;
      top: -75px;
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 150px;
      height: 150px;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 50%;
      right: 50px;
      bottom: -100px;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 620px;
    }

    .hero-label {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 100px;
      background: rgba(255,255,255,.13);
      border: 1px solid rgba(255,255,255,.14);
      font-size: 10px;
      font-weight: 700;
      margin-bottom: 14px;
    }

    .hero-label i {
      font-size: 14px;
    }

    .hero h1 {
      font-size: clamp(27px, 4vw, 39px);
      line-height: 1.12;
      letter-spacing: -1.3px;
      margin-bottom: 12px;
      font-weight: 800;
    }

    .hero p {
      max-width: 570px;
      color: rgba(255,255,255,.8);
      line-height: 1.65;
      font-size: 13px;
    }

    .hero-button {
      margin-top: 20px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 16px;
      background: white;
      color: #4038c9;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 800;
      transition: .2s ease;
    }

    .hero-button:hover {
      transform: translateY(-2px);
    }

    .hero-decoration {
      position: absolute;
      right: 50px;
      bottom: 0;
      width: 190px;
      height: 190px;
      opacity: .12;
    }

    .hero-decoration i {
      font-size: 190px;
    }

    /* =========================
       SEARCH
    ========================= */

    .search-wrap {
      margin-top: 25px;
      position: relative;
    }

    .search-box {
      width: 100%;
      height: 57px;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 18px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow-small);
    }

    .search-box i {
      font-size: 21px;
      color: var(--muted);
    }

    .search-box input {
      flex: 1;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      font-size: 13px;
    }

    .search-box input::placeholder {
      color: #a0a7b5;
    }

    .search-shortcut {
      color: #a0a7b5;
      border: 1px solid var(--border);
      padding: 4px 7px;
      border-radius: 7px;
      font-size: 10px;
      font-weight: 700;
    }

    /* =========================
       SECTION
    ========================= */

    .section {
      margin-top: 34px;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    .section-title {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -.5px;
    }

    .section-description {
      margin-top: 4px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.5;
    }

    .section-action {
      display: flex;
      align-items: center;
      gap: 4px;
      color: var(--primary);
      font-size: 11px;
      font-weight: 800;
      background: transparent;
    }

    /* =========================
       CATEGORY FILTER
    ========================= */

    .categories {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    .categories::-webkit-scrollbar {
      display: none;
    }

    .category {
      flex: 0 0 auto;
      padding: 9px 14px;
      border-radius: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      transition: .2s ease;
    }

    .category.active {
      background: var(--primary);
      border-color: var(--primary);
      color: white;
    }

    /* =========================
       APP GRID
    ========================= */

    .app-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 13px;
    }

    .app-card {
      position: relative;
      min-height: 190px;
      padding: 20px;
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-small);
      display: flex;
      flex-direction: column;
      transition: transform .25s ease, box-shadow .25s ease;
      cursor: pointer;
      overflow: hidden;
    }

    .app-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 35px rgba(23,32,51,.1);
    }

    .app-icon {
      width: 47px;
      height: 47px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }

    .app-icon i {
      font-size: 23px;
    }

    .icon-purple {
      color: #5148df;
      background: #efefff;
    }

    .icon-green {
      color: #15966b;
      background: #eaf9f3;
    }

    .icon-orange {
      color: #e88a18;
      background: #fff4e3;
    }

    .icon-blue {
      color: #3982e6;
      background: #edf5ff;
    }

    .icon-pink {
      color: #db4b82;
      background: #fff0f5;
    }

    .icon-cyan {
      color: #168ba5;
      background: #eaf8fb;
    }

    .app-card h3 {
      font-size: 14px;
      font-weight: 800;
      letter-spacing: -.3px;
    }

    .app-card p {
      color: var(--muted);
      font-size: 10.5px;
      line-height: 1.55;
      margin-top: 6px;
      max-width: 210px;
    }

    .app-arrow {
      margin-top: auto;
      padding-top: 17px;
      color: #a3a9b5;
      display: flex;
      justify-content: flex-end;
    }

    .app-arrow i {
      font-size: 18px;
      transition: .2s ease;
    }

    .app-card:hover .app-arrow i {
      color: var(--primary);
      transform: translateX(3px);
    }

    .status-dot {
      position: absolute;
      right: 18px;
      top: 20px;
      width: 7px;
      height: 7px;
      background: #25b47a;
      border-radius: 50%;
      box-shadow: 0 0 0 4px rgba(37,180,122,.09);
    }

    /* =========================
       FEATURED CARD
    ========================= */

    .featured-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 14px;
    }

    .featured-card {
      position: relative;
      min-height: 210px;
      padding: 25px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .featured-card.mental {
      background: linear-gradient(130deg, #187b61, #249b78);
    }

    .featured-card.donation {
      background: linear-gradient(130deg, #c84576, #e26391);
    }

    .featured-card::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      border: 1px solid rgba(255,255,255,.13);
      border-radius: 50%;
      right: -60px;
      bottom: -85px;
    }

    .featured-top,
    .featured-bottom {
      position: relative;
      z-index: 2;
    }

    .featured-icon {
      width: 43px;
      height: 43px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,.14);
      border-radius: 13px;
      margin-bottom: 16px;
    }

    .featured-icon i {
      font-size: 22px;
    }

    .featured-card h3 {
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -.5px;
    }

    .featured-card p {
      margin-top: 7px;
      max-width: 430px;
      font-size: 10.5px;
      line-height: 1.6;
      color: rgba(255,255,255,.78);
    }

    .featured-button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10.5px;
      font-weight: 800;
      color: white;
    }

    /* =========================
       LIST SERVICE
    ========================= */

    .service-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .service-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 15px;
      display: flex;
      align-items: center;
      gap: 13px;
      transition: .2s ease;
    }

    .service-item:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-small);
    }

    .service-icon {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
    }

    .service-icon i {
      font-size: 20px;
    }

    .service-info {
      min-width: 0;
      flex: 1;
    }

    .service-info strong {
      display: block;
      font-size: 12px;
      font-weight: 800;
    }

    .service-info span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.45;
      margin-top: 3px;
    }

    .service-go {
      color: #a1a7b2;
      font-size: 18px;
    }

    /* =========================
       INFO
    ========================= */

    .info-card {
      margin-top: 34px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 20px;
      display: flex;
      gap: 15px;
      align-items: flex-start;
    }

    .info-icon {
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: var(--primary-soft);
      color: var(--primary);
    }

    .info-icon i {
      font-size: 19px;
    }

    .info-card h4 {
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 4px;
    }

    .info-card p {
      font-size: 10px;
      line-height: 1.6;
      color: var(--muted);
    }

    /* =========================
       BOTTOM NAV
    ========================= */

    .bottom-nav-wrap {
      position: fixed;
      z-index: 100;
      left: 50%;
      bottom: 16px;
      transform: translateX(-50%);
      width: min(530px, calc(100% - 28px));
    }

    .bottom-nav {
      height: var(--nav-height);
      background: rgba(255,255,255,.94);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(220,225,234,.9);
      box-shadow: 0 15px 45px rgba(22,29,45,.14);
      border-radius: 22px;
      padding: 8px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .nav-item {
      position: relative;
      background: transparent;
      color: #9299a7;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 4px;
      transition: .2s ease;
    }

    .nav-item i {
      font-size: 21px;
    }

    .nav-item span {
      font-size: 9px;
      font-weight: 700;
    }

    .nav-item.active {
      color: var(--primary);
      background: var(--primary-soft);
    }

    /* =========================
       MODAL
    ========================= */

    .modal-overlay {
      position: fixed;
      z-index: 200;
      inset: 0;
      background: rgba(12,18,30,.45);
      display: none;
      align-items: flex-end;
      justify-content: center;
      padding: 18px;
      backdrop-filter: blur(5px);
    }

    .modal-overlay.show {
      display: flex;
      animation: fadeIn .2s ease;
    }

    .modal {
      width: min(530px, 100%);
      max-height: 85vh;
      overflow-y: auto;
      background: var(--surface);
      border-radius: 25px;
      padding: 25px;
      animation: modalUp .28s ease;
      box-shadow: 0 25px 80px rgba(0,0,0,.2);
    }

    .modal-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 15px;
    }

    .modal-title {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .modal-title .app-icon {
      margin: 0;
    }

    .modal-title h3 {
      font-size: 17px;
      font-weight: 800;
    }

    .modal-title p {
      color: var(--muted);
      font-size: 10px;
      margin-top: 3px;
    }

    .modal-close {
      width: 35px;
      height: 35px;
      border-radius: 10px;
      background: var(--surface-2);
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .modal-body {
      margin-top: 22px;
    }

    .modal-body p {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.7;
    }

    .modal-actions {
      display: flex;
      gap: 8px;
      margin-top: 22px;
    }

    .modal-primary,
    .modal-secondary {
      flex: 1;
      min-height: 44px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 800;
    }

    .modal-primary {
      background: var(--primary);
      color: white;
    }

    .modal-secondary {
      background: var(--surface-2);
      color: var(--text);
    }

    /* =========================
       TOAST
    ========================= */

    .toast {
      position: fixed;
      z-index: 300;
      left: 50%;
      bottom: 105px;
      transform: translate(-50%, 15px);
      background: #172033;
      color: white;
      padding: 11px 15px;
      border-radius: 11px;
      font-size: 10px;
      font-weight: 700;
      opacity: 0;
      pointer-events: none;
      transition: .25s ease;
      white-space: nowrap;
    }

    .toast.show {
      opacity: 1;
      transform: translate(-50%, 0);
    }

    /* =========================
       DARK MODE
    ========================= */

    body.dark {
      --bg: #11151e;
      --surface: #181d28;
      --surface-2: #202633;
      --text: #f2f4f8;
      --muted: #929aaa;
      --border: #29303e;

      --primary-soft: #242552;

      --shadow: 0 10px 35px rgba(0,0,0,.2);
      --shadow-small: 0 5px 18px rgba(0,0,0,.16);
    }

    body.dark .bottom-nav {
      background: rgba(24,29,40,.94);
      border-color: #2b3240;
    }

    body.dark .icon-purple {
      background: #28264b;
    }

    body.dark .icon-green {
      background: #19352e;
    }

    body.dark .icon-orange {
      background: #382d1c;
    }

    body.dark .icon-blue {
      background: #1c2c42;
    }

    body.dark .icon-pink {
      background: #38232d;
    }

    body.dark .icon-cyan {
      background: #1c3238;
    }

    /* =========================
       ANIMATIONS
    ========================= */

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes modalUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes cardIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .app-card,
    .service-item {
      animation: cardIn .35s ease both;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 900px) {
      .app-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .featured-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 620px) {
      .app {
        padding: 0 15px 105px;
      }

      .topbar {
        height: 72px;
      }

      .hero {
        min-height: 315px;
        padding: 28px 25px;
        align-items: flex-start;
      }

      .hero-decoration {
        right: -10px;
        bottom: -25px;
        opacity: .08;
      }

      .hero h1 {
        font-size: 28px;
      }

      .hero p {
        font-size: 11px;
      }

      .search-shortcut {
        display: none;
      }

      .app-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }

      .app-card {
        min-height: 175px;
        padding: 16px;
      }

      .app-icon {
        width: 43px;
        height: 43px;
        margin-bottom: 14px;
      }

      .service-list {
        grid-template-columns: 1fr;
      }

      .section {
        margin-top: 28px;
      }
    }

    @media (max-width: 390px) {
      .app-grid {
        grid-template-columns: 1fr 1fr;
      }

      .app-card h3 {
        font-size: 13px;
      }

      .app-card p {
        font-size: 9.5px;
      }

      .brand-name span {
        display: none;
      }
    }

    .icon-red {
  color: #d64545;
  background: #fff0f0;
}

body.dark .icon-red {
  background: #3a2427;
}

.icon-purple {
  background: #f3e8ff;
  color: #7c3aed;
}

.icon-olive {
