function checkExistingSession() {

  const session =
    localStorage.getItem(
      "ngl-session"
    );

  if (!session) return;

  try {

    const data =
      JSON.parse(session);

    /**
     * Session berlaku 8 jam.
     */
    const eightHours =
      8 * 60 * 60 * 1000;

    if (
      Date.now() -
      data.verifiedAt <
      eightHours
    ) {

      verifiedUser = data;

      document
        .getElementById(
          "verificationGate"
        )
        .classList.add("hidden");

      applyRoleAccess();

    } else {

      localStorage.removeItem(
        "ngl-session"
      );

    }

  } catch {

    localStorage.removeItem(
      "ngl-session"
    );

  }

}

